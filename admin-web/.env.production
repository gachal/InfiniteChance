# public path
VITE_BASE=/

# 接口地址(nginx :8090 与 desktop webmux 同契约:/api → 网关,/canvas-api → 画布)
VITE_GLOB_API_URL=/api

# 是否开启压缩,可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式(部署为 SPA history 回退,nginx 与 desktop 均已配置)
VITE_ROUTER_HISTORY=history

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
