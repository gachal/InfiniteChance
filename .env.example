# InfiniteChance 全栈配置样例(16 号票)。
# 复制为 .env 后按需修改:cp .env.example .env ;docker compose 自动读取同目录 .env。
# 所有项都有内置缺省:不加 .env 直接 docker compose up -d --build 也能拉起
# 本机自用栈(会话使用内置公开开发密钥,仅限本机)。

# —— 会话安全 ——
# 管理员 JWT 签名密钥,网关与画布必须一致。生成方式:
#   openssl rand -hex 32
# 留空 = 使用内置公开开发密钥(任何人可伪造会话,仅限本机自用)。
JWT_SECRET=
# 置 true 后:JWT_SECRET 缺失或为空时两个服务拒绝启动。
# 公网/长期部署务必先配好 JWT_SECRET 再开启。
JWT_SECRET_REQUIRED=false

# —— 数据库 ——
# MySQL root 密码。只对「空的 mysql-data 卷」首次初始化生效;已有卷改这里
# 不会改既有账号,容器内 DSN 由 compose 按同一变量拼接,改卷内密码需重建卷。
MYSQL_ROOT_PASSWORD=infinitechance

# —— 画布 worker ——
# canvas/server 调网关用的服务级 key:在管理后台「API Keys」创建后填到这里,
# 再 docker compose up -d 生效;留空时画布 AI 动作以 gateway_unconfigured 拒绝。
CANVAS_SERVICE_KEY=
# 画布生成任务的并发上限(缺省 2)。
CANVAS_TASK_CONCURRENCY=2

# —— 宿主机端口 ——
# 管理后台(初始化引导入口)与创作画布前端
ADMIN_WEB_PORT=8090
CANVAS_WEB_PORT=8091
# 网关 API(OpenAI 兼容 /v1,SDK base_url 指这里)与画布 API
GATEWAY_PORT=8080
CANVAS_PORT=8081
# MySQL / Redis 宿主机映射(Go 集成测试默认连 3307/6380,别随意改)
MYSQL_PORT=3307
REDIS_PORT=6380
